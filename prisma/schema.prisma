generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BrandStatus {
  NEW
  SCREENING
  APPROVED
  CONTACTED
  REPLIED
  REJECTED
  ONBOARDED
}

enum OutreachType {
  COLD_EMAIL_DRAFTED
  COLD_EMAIL_SENT
  FOLLOW_UP_DRAFTED
  FOLLOW_UP_SENT
  REPLY_RECEIVED
  NOTE
}

enum OutreachStatus {
  PENDING
  SENT
  FAILED
}

model Brand {
  id            String      @id @default(uuid())
  sourceNo      Int?        @unique // legacy 'no' column from the Excel/Firestore import; nullable for brands added later
  methodology   String?     // 방법론 — sourcing method
  channel       String?     // 채널
  name          String
  website       String?
  websiteDomain String?     // normalized host (e.g. "mathez.fr"), extracted server-side — used for duplicate detection
  country       String?
  sku           String?
  foundedYear   Int?
  contactPoint  String?     // raw 'Contact point' column from the sheet
  coldEmail     Boolean?    // null = not decided yet, true/false once someone answers
  reply         Boolean     @default(false)
  status        BrandStatus @default(NEW)
  notes         String?     @db.Text

  contacts      Contact[]
  outreachLogs  OutreachLog[]
  logs          BrandLog[]

  // Who may edit/delete this record, per src/lib/auth/ownership.ts -- ADMIN or this
  // user only. Nullable: rows created before this field existed, or whose creator's
  // account was later deleted, have no owner and are ADMIN-only.
  createdById   String?
  createdBy     User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([name])
  @@index([websiteDomain])
  @@index([createdById])
  @@unique([name, websiteDomain], map: "brand_name_domain_unique")
}

// A running, comment-style progress log per brand -- "우리가 지금 이 브랜드랑 어디까지
// 얘기됐는지" (contact history, sample status, reminders sent). No threading, unlike
// WorkComment -- this mirrors the flat dated-entry style the team already kept by hand
// in a spreadsheet column, just moved into the app. A brand having any log entries at
// all is also what marks it as "actively being worked" for the /brands/communications
// view, as opposed to the other ~1300 brands that were only ever sourced/imported.
model BrandLog {
  id        String   @id @default(uuid())
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  body      String   @db.Text

  // Who may edit/delete this entry -- see src/lib/auth/ownership.ts. Also doubles as
  // "who wrote this note" for display, so unlike other models this one is never left
  // null on new entries (backfilled historical entries may still be null -- attributed
  // to whoever did the import, same convention as every other backfilled content type).
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([brandId])
  @@index([createdById])
}

model SourcingRun {
  id         String              @id @default(uuid())
  createdAt  DateTime            @default(now())
  status     String              @default("running") // "running" | "done" | "stopped" | "error"
  pid        Int?                // OS process id of the running python-sourcing/main.py, so it can be killed on Stop
  progress   Json?               // { stage, stageProgress: {discovery,dedup,website,koreaCheck,scoring}, counts: {...}, errors }
  candidates SourcingCandidate[]
}

model SourcingCandidate {
  id           String      @id @default(uuid())
  runId        String
  run          SourcingRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  name         String
  methodology  String?     // which discovery bucket surfaced this candidate (e.g. "Brand Sourcing — Snacks")
  country      String?
  sku          String?
  foundedYear  Int?
  website      String?

  verdict      String      // "pass" | "flag" | "reject" — same union as EvaluationResult, kept as a plain string for consistency with evaluate.ts
  reason       String      @db.Text
  evidence     String[]    // citation URLs gathered during LLM verification

  createdAt    DateTime    @default(now())

  @@index([runId])
}

enum WorkStatus {
  TODO           // 대기
  AWAITING_REPLY // 답변대기
  IN_PROGRESS    // 진행중
  DONE           // 완료
}

// A real roster, independent of whether someone currently has any work items -- lets
// "add a person" be its own action instead of only happening as a side effect of
// creating their first task. No auth yet, so no role gate on who can add one (see
// AddPersonForm) -- that's meant to become admin-only once login exists.
model Person {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

enum UserRole {
  ADMIN
  USER
}

// Real login accounts (Credentials provider, see src/auth.ts). Deliberately separate
// from Person (the assignee roster) -- not every logged-in account needs to be an
// assignee, and not every assignee needs a login yet. `username` rather than `email`
// because one seeded account ("admin") isn't a real email address.
model User {
  id           String   @id @default(uuid())
  username     String   @unique
  name         String
  passwordHash String
  role         UserRole @default(USER)
  // Section keys from src/lib/access-control.ts (e.g. "brands", "stores") -- ignored
  // entirely for ADMIN, who always has full access. Permission changes only take
  // effect on that user's next sign-in, since sessions are JWT-based (no server-side
  // session store to push a live update through).
  allowedPages String[] @default([])
  createdAt    DateTime @default(now())

  // Back-relations for the createdById ownership field on each content model -- see
  // src/lib/auth/ownership.ts. Never read from these arrays directly; they exist only
  // because Prisma requires both sides of a relation to be declared.
  createdBrands           Brand[]
  createdWorkItems        WorkItem[]
  createdWorkComments     WorkComment[]
  createdStores           Store[]
  createdStoreVisits      StoreVisit[]
  createdProducts         Product[]
  createdStoreVisitPhotos StoreVisitPhoto[]
  createdBrandLogs        BrandLog[]
}

model WorkItem {
  id           String        @id @default(uuid())
  title        String
  content      String?       @db.Text
  status       WorkStatus    @default(TODO)
  color        String?       // exact hex e.g. "#a48bff" -- free-form, not a fixed enum, to match imported label colors exactly
  category     String?       // brand/topic grouping, e.g. "PG / 피에로구르망"
  startDate    DateTime?
  endDate      DateTime?
  fileUrl      String?       // Vercel Blob URL
  fileName     String?       // original filename, shown/downloaded as this
  assigneeName String        // no auth yet -- just a plain name, not a user relation

  comments     WorkComment[]

  // Who may edit/delete this record -- see src/lib/auth/ownership.ts.
  createdById  String?
  createdBy    User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([assigneeName])
  @@index([title])
  @@index([category])
  @@index([createdById])
}

model WorkComment {
  id         String        @id @default(uuid())
  workItemId String
  workItem   WorkItem      @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  // One level of replies, same shape as a Slack thread -- a reply's parent is always
  // a root comment, never another reply.
  parentId   String?
  parent     WorkComment?  @relation("WorkCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    WorkComment[] @relation("WorkCommentReplies")

  authorName String
  body       String        @db.Text

  // Who may edit/delete this comment -- see src/lib/auth/ownership.ts. authorName above
  // is display-only (a plain string snapshot); this is the real identity used for auth.
  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt  DateTime      @default(now())

  @@index([workItemId])
  @@index([parentId])
  @@index([createdById])
}

model Contact {
  id          String   @id @default(uuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  name        String?
  email       String?
  role        String?
  isPrimary   Boolean  @default(false)

  outreachLogs OutreachLog[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([brandId])
  @@unique([brandId, email])
}

model OutreachLog {
  id             String         @id @default(uuid())
  brandId        String
  brand          Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)

  type           OutreachType
  status         OutreachStatus @default(PENDING)
  subject        String?
  body           String?        @db.Text
  graphMessageId String?        // Outlook draft/message id from Microsoft Graph — idempotency key, prevents double-drafting on retry

  createdAt      DateTime       @default(now())

  @@index([brandId])
  @@index([contactId])
}

// ===== Field / Store Visit =====================================================
// Completely independent of Brand/Sourcing/Work -- its own Product master, its own
// visit records. Nothing here reads or writes those models.

enum StoreType {
  DEPARTMENT_STORE
  HYPERMARKET
  CONVENIENCE_STORE
  WAREHOUSE
  DRUGSTORE
  OTHER
}

enum StoreVisitStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
}

enum StoreVisitProductCategory {
  SNACK
  CHOCOLATE
  BISCUIT
  COOKIE
  CANDY
  JELLY
  NUTS
  FOOD
  BEVERAGE
  OTHER
}

enum StoreVisitPhotoType {
  PRODUCT
  PRICE_TAG
  DISPLAY
  PROMOTION
  STORE
  OTHER
}

model Store {
  id        String      @id @default(uuid())
  name      String
  chain     String?     // free-form, not a master table, e.g. "이마트", "CU"
  storeType StoreType   @default(OTHER)
  address   String?
  city      String?
  isActive  Boolean     @default(true) // soft-delete -- a store with visit history is deactivated, never hard-deleted
  imageUrl  String?     // representative photo of the store itself (exterior/entrance) -- not tied to any one visit
  imageName String?

  visits    StoreVisit[]

  // Who may edit/delete this record -- see src/lib/auth/ownership.ts.
  createdById String?
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([name])
  @@index([chain])
  @@index([createdById])
}

model StoreVisit {
  id        String            @id @default(uuid())
  storeId   String
  store     Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)

  visitDate DateTime
  visitor   String            // no auth yet -- just a plain name, same as WorkItem.assigneeName
  status    StoreVisitStatus  @default(IN_PROGRESS)
  memo      String?           @db.Text

  items     Product[]
  photos    StoreVisitPhoto[] // store-level photos (storeVisitItemId null on these)

  // Who may edit/delete this record -- see src/lib/auth/ownership.ts.
  createdById String?
  createdBy   User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([storeId])
  @@index([visitDate])
  @@index([createdById])
}

// A product as seen during one specific visit -- brand/category/barcode AND
// price/promo/stock/display all live on the same record. Deliberately not shared or
// reused across visits: the same physical product seen again on a later visit gets its
// own separate row, since a visit's product entry is a snapshot of that one visit.
// Photos (including a shot of the product itself) live on StoreVisitPhoto, not here.
model Product {
  id              String            @id @default(uuid())
  storeVisitId    String
  storeVisit      StoreVisit        @relation(fields: [storeVisitId], references: [id], onDelete: Cascade)

  brandName       String?
  productName     String
  category        StoreVisitProductCategory @default(OTHER)
  subcategory     String?
  barcode         String?
  countryOfOrigin String?
  manufacturer    String?
  packageSize     String?

  price           Int?              // KRW, whole-won -- no fractional currency in practice, kept simple (no Decimal precedent in this project)
  currency        String            @default("KRW")
  promotion       String?
  stockStatus     String?
  displayLocation String?
  facingCount     Int?
  memo            String?           @db.Text

  photos          StoreVisitPhoto[]

  // Who may edit/delete this record -- see src/lib/auth/ownership.ts.
  createdById     String?
  createdBy       User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([storeVisitId])
  @@index([productName])
  @@index([brandName])
  @@index([barcode])
  @@index([createdById])
}

model StoreVisitPhoto {
  id               String           @id @default(uuid())
  storeVisitId     String
  storeVisit       StoreVisit       @relation(fields: [storeVisitId], references: [id], onDelete: Cascade)
  storeVisitItemId String?          // null = store-level photo (whole store/entrance/aisle), set = product-level photo
  storeVisitItem   Product?         @relation(fields: [storeVisitItemId], references: [id], onDelete: Cascade)

  photoType        StoreVisitPhotoType @default(OTHER)
  fileUrl          String           // Vercel Blob URL, same convention as WorkItem.fileUrl
  fileName         String?
  caption          String?

  // Who may edit/delete this record -- see src/lib/auth/ownership.ts.
  createdById      String?
  createdBy        User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt        DateTime         @default(now())

  @@index([storeVisitId])
  @@index([storeVisitItemId])
  @@index([createdById])
}