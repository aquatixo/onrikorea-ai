generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BrandStatus {
  NEW
  SCREENING
  APPROVED
  CONTACTED
  REPLIED
  REJECTED
  ONBOARDED
}

enum OutreachType {
  COLD_EMAIL_DRAFTED
  COLD_EMAIL_SENT
  FOLLOW_UP_DRAFTED
  FOLLOW_UP_SENT
  REPLY_RECEIVED
  NOTE
}

enum OutreachStatus {
  PENDING
  SENT
  FAILED
}

model Brand {
  id            String      @id @default(uuid())
  sourceNo      Int?        @unique // legacy 'no' column from the Excel/Firestore import; nullable for brands added later
  methodology   String?     // 방법론 — sourcing method
  channel       String?     // 채널
  name          String
  website       String?
  websiteDomain String?     // normalized host (e.g. "mathez.fr"), extracted server-side — used for duplicate detection
  country       String?
  sku           String?
  foundedYear   Int?
  contactPoint  String?     // raw 'Contact point' column from the sheet
  coldEmail     Boolean     @default(false)
  reply         Boolean     @default(false)
  status        BrandStatus @default(NEW)
  notes         String?     @db.Text

  contacts      Contact[]
  outreachLogs  OutreachLog[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([name])
  @@index([websiteDomain])
  @@unique([name, websiteDomain], map: "brand_name_domain_unique")
}

model SourcingRun {
  id         String              @id @default(uuid())
  createdAt  DateTime            @default(now())
  candidates SourcingCandidate[]
}

model SourcingCandidate {
  id           String      @id @default(uuid())
  runId        String
  run          SourcingRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  name         String
  methodology  String?     // which discovery bucket surfaced this candidate (e.g. "Brand Sourcing — Snacks")
  country      String?
  sku          String?
  foundedYear  Int?
  website      String?

  verdict      String      // "pass" | "flag" | "reject" — same union as EvaluationResult, kept as a plain string for consistency with evaluate.ts
  reason       String      @db.Text
  evidence     String[]    // citation URLs gathered during LLM verification

  createdAt    DateTime    @default(now())

  @@index([runId])
}

enum WorkStatus {
  TODO           // 대기
  AWAITING_REPLY // 답변대기
  IN_PROGRESS    // 진행중
  DONE           // 완료
}

model WorkItem {
  id           String        @id @default(uuid())
  title        String
  content      String?       @db.Text
  status       WorkStatus    @default(TODO)
  color        String?       // exact hex e.g. "#a48bff" -- free-form, not a fixed enum, to match imported label colors exactly
  category     String?       // brand/topic grouping, e.g. "PG / 피에로구르망"
  startDate    DateTime?
  endDate      DateTime?
  fileUrl      String?       // Vercel Blob URL
  fileName     String?       // original filename, shown/downloaded as this
  assigneeName String        // no auth yet -- just a plain name, not a user relation

  comments     WorkComment[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([assigneeName])
  @@index([title])
  @@index([category])
}

model WorkComment {
  id         String        @id @default(uuid())
  workItemId String
  workItem   WorkItem      @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  // One level of replies, same shape as a Slack thread -- a reply's parent is always
  // a root comment, never another reply.
  parentId   String?
  parent     WorkComment?  @relation("WorkCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    WorkComment[] @relation("WorkCommentReplies")

  authorName String
  body       String        @db.Text

  createdAt  DateTime      @default(now())

  @@index([workItemId])
  @@index([parentId])
}

model Contact {
  id          String   @id @default(uuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  name        String?
  email       String?
  role        String?
  isPrimary   Boolean  @default(false)

  outreachLogs OutreachLog[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([brandId])
  @@unique([brandId, email])
}

model OutreachLog {
  id             String         @id @default(uuid())
  brandId        String
  brand          Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)

  type           OutreachType
  status         OutreachStatus @default(PENDING)
  subject        String?
  body           String?        @db.Text
  graphMessageId String?        // Outlook draft/message id from Microsoft Graph — idempotency key, prevents double-drafting on retry

  createdAt      DateTime       @default(now())

  @@index([brandId])
  @@index([contactId])
}